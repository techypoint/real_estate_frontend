# Copy to .env.local and fill in. .env.local is gitignored.

# Java backend base URL. Only read on the server — never sent to the browser.
API_ORIGIN=http://localhost:8888

# Public site origin — feeds metadataBase, robots.ts, sitemap.ts. Must be the
# real domain in prod.
SITE_URL=http://localhost:3000

# Shared secret the Java backend sends as `x-revalidate-secret` when calling
# POST /api/revalidate?reg=<REG>. Generate a fresh value per environment,
# e.g. `openssl rand -hex 32`. Must match whatever the Java backend is
# configured to send.
REVALIDATE_SECRET=<shared-secret-with-java-backend>

# ---- Admin panel (/admin) ----
# Login for the admin panel — plain username and password.
ADMIN_USERNAME=varun
ADMIN_PASSWORD=<password>
# Signs the admin login cookie. `openssl rand -hex 32`, different per environment.
ADMIN_SESSION_SECRET=<random>
# Sent to the Java backend as x-admin-secret on /api/admin/** calls. Must equal
# app.admin-secret in the backend's application-<profile>.properties.
ADMIN_API_SECRET=<shared-secret-with-java-backend>
