# Copy to .env.local and fill in. .env.local is gitignored.

# Java backend base URL. Only read on the server — never sent to the browser.
API_ORIGIN=http://localhost:8888

# Public site origin — feeds metadataBase, robots.ts, sitemap.ts. Must be the
# real domain in prod.
SITE_URL=http://localhost:3000

# Shared secret the Java backend sends as `x-revalidate-secret` when calling
# POST /api/revalidate?reg=<REG>. Generate a fresh value per environment,
# e.g. `openssl rand -hex 32`. Must match whatever the Java backend is
# configured to send.
REVALIDATE_SECRET=<shared-secret-with-java-backend>
